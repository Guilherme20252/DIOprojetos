const vitorias = parseInt(gets());
const derrotas = parseInt(gets());

function calcularRankeadas(vitorias, derrotas) {
    const saldoVitorias = vitorias - derrotas;

    let nivel;

    if (vitorias <= 10){
        nivel = "ferro";
    }
    else if (vitorias >= 11 && vitorias <= 20){
        nivel = "bronze";
    }
    else if(vitorias <= 21 && 50){
        nivel = "prata";
    }
    else if(vitorias <= 51 && 80){
        nivel = "ouro";
    }
    else if(vitorias <= 81 && 90){
        nivel = "diamante";
    }
    else if(vitorias <= 91 && 100){
        nivel = "lendário";
    }
    else if(vitorias >= 100){
        nivel = "lendário";
    }

    print('O heroi tem o saldo de ${saldoVitorias} esta no nivel ${nivel}');
}
    calcularRankeadas(vitorias, derrotas);
    
